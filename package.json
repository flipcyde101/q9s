{
  "name": "@drod915/q9s",
  "version": "0.1.0",
  "description": "k9s for background job queues: terminal dashboard and safe DLQ inspector for BullMQ, River, and pg-boss",
  "type": "module",
  "license": "MIT",
  "author": "flipcyde101",
  "repository": {
    "type": "git",
    "url": "https://github.com/flipcyde101/q9s.git"
  },
  "homepage": "https://github.com/flipcyde101/q9s#readme",
  "bugs": {
    "url": "https://github.com/flipcyde101/q9s/issues"
  },
  "keywords": [
    "queue",
    "bullmq",
    "river",
    "pg-boss",
    "redis",
    "postgres",
    "dlq",
    "cli",
    "k9s",
    "observability"
  ],
  "bin": {
    "q9s": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node -e \"import('node:fs').then(fs => fs.rmSync('dist', { recursive: true, force: true }))\" && tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
